print("\n2. EXTRACTING EMAIL ADDRESSES")
print("------------------------------------------")

input_file = "emails.txt"
output_file = "extracted_emails.txt"

# Create sample file if it does not exist
if not os.path.exists(input_file):

    with open(input_file, "w") as file:
        file.write(
            "Contact: akshay@gmail.com\n"
            "Student: student123@yahoo.com\n"
            "Support: support@example.com\n"
        )

# Read the text file
with open(input_file, "r") as file:
    text = file.read()

# Email pattern
email_pattern = r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"

# Find email addresses
emails = re.findall(email_pattern, text)

# Remove duplicate emails
emails = list(dict.fromkeys(emails))

# Save emails to another file
with open(output_file, "w") as file:

    for email in emails:
        file.write(email + "\n")

# Display emails
for email in emails:
    print(email)

print("Total emails found:", len(emails))
print("Emails saved to:", output_file)


